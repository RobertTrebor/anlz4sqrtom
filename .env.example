# Kopiere diese Datei nach .env.local und trage deine Werte ein.
# .env.local wird NICHT eingecheckt.

# OAuth-App (Foursquare Developer Console) – für Login und Swarm-Check-ins (v2-API)
FSQ_CLIENT_ID=
FSQ_CLIENT_SECRET=

# Muss exakt so als Redirect-URL in der Developer Console eingetragen sein.
# Lokal: http://localhost:3000/api/auth/callback
FSQ_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Service Key (Developer Console) – nur für die Ortssuche (neue Places API)
FSQ_SERVICE_KEY=
